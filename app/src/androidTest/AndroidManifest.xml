<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Required so the instrumented test process (com.gb4pc.test) can see MediaStore
        rows inserted by other packages (e2e-mock-camera, applicationId
        com.google.android.GoogleCamera).

        Without this, E2EFixture.countMediaStoreImages()'s query of
        MediaStore.Images.Media.EXTERNAL_CONTENT_URI only returns rows owned by
        com.gb4pc.test itself (scoped storage, API 29+), so captureOnePhoto() never
        observes the row the mock camera wrote and times out (issues #231/#232).

        READ_MEDIA_IMAGES (API 33+) and READ_EXTERNAL_STORAGE (API 29-32) are both
        declared so the grant below covers the full minSdk 26..targetSdk 35 range;
        READ_EXTERNAL_STORAGE is a no-op on API 33+ but harmless to request.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

</manifest>
