<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for API 31+ (issue #1235). Everything is eligible for cloud backup and device
    transfer except the per-install prefs file, Constants.INSTALL_PREFS_NAME, which records whether
    the service is on and what setup and the permission dialogs have done on this install.
    API 26-30 read backup_rules.xml instead; keep the two in step.
    BackupRulesRobolectricTest checks both against the constant.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="gb4pc_install_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="gb4pc_install_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
