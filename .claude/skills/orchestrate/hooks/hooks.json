{
  "description": "Refuse a dispatch to one of this plugin's agents whose prompt is not the five-line dispatch form (reference/dispatch-form.md); apply /orch-hooks when a person types it; keep tool calls away from the hook state.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/check_dispatch.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|Monitor|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/protect_state.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "(^|:)orch-hooks$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/hook_state.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
